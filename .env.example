# Required. Create this key in Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cheapest model for the first pass. Use gemini-3.1-flash-image for harder items.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Project paths. Do not put logs or metadata inside new_images.
PRODUCT_INPUT_DIR=new_images
PRODUCT_OUTPUT_DIR=generated_candidates

# Nano Banana 2 Lite supports 1K. Keep this at 1K for the lowest cost.
GEMINI_IMAGE_SIZE=1K
GEMINI_ASPECT_RATIO=1:1

